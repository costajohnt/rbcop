==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 94 <==

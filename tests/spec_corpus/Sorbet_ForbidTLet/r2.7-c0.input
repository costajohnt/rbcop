==> .rubocop.yml 178 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/ForbidTLet:
  AutocorrectToRBS: true


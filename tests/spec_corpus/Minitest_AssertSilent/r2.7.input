==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 142 <==
class FooTest < Minitest::Test
  def test_do_something
    assert_output("something", "") do
      puts object.do_something
    end
  end
end


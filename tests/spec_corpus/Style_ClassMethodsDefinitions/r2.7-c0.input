==> .rubocop.yml 165 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/ClassMethodsDefinitions:
  EnforcedStyle: def_self


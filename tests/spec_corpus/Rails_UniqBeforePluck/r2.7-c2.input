==> .rubocop.yml 184 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/UniqBeforePluck:
  EnforcedStyle: aggressive


    @app = app
    @counter = 0
  end

  def call(env)
    @app.call(env)
  ensure
    @counter += 1
  end
end

==> app/middleware/010/010.rb 256 <==
class TestMiddleware
  def initialize(app)
    @app = app
    @counter = Concurrent::AtomicReference.new(0)
    @unsafe_counter = 0
  end

  def call(env)
    @app.call(env)
  ensure
    @unsafe_counter += 1
    @counter.update { |ref| ref + 1 }
  end
end


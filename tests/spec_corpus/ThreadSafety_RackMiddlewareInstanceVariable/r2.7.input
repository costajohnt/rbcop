==> app/middleware/022/022.rb 203 <==
class TestMiddleware
  def initialize(app, options)
    @app = app
    @options = options
  end

  def call(env)
    if options[:noop]
      [200, {}, []]
    else
      @app.call(env)
    end
  end
end


==> .rubocop.yml 211 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ExpectChange:
  EnforcedStyle: method_call
  NegatedMatcher: not_change

==> 000/000_spec.rb 56 <==
it do
  expect { run }.to not_change { User.count }
end


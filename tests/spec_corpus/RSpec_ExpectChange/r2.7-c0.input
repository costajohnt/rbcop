==> .rubocop.yml 182 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ExpectChange:
  EnforcedStyle: method_call


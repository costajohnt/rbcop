==> .rubocop.yml 223 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/HashAlignment:
  EnforcedHashRocketStyle:
  - key
  - separator
  EnforcedColonStyle:
  - key
  - separator


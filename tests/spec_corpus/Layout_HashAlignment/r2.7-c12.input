==> .rubocop.yml 193 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/HashAlignment:
  EnforcedHashRocketStyle: key
  EnforcedColonStyle: separator

==> 000.rb 70 <==
hash1 = {
  a:   0,
  bbb: 1
}
hash2 = {
    'a' => 0,
  'bbb' => 1
}

==> 001.rb 68 <==
hash1 = {
    a: 0,
  bbb: 1
}
hash2 = {
  'a' => 0,
  'bbb' => 1
}


==> .rubocop.yml 215 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/HashAlignment:
  EnforcedHashRocketStyle:
  - table
  - key
  EnforcedColonStyle:
  - table
  - key

==> 000.rb 112 <==
hash = {
  'abcdefg' => 0,
  'abcdef'  => 0,
  'gijk'    => 0,
  'a'       => 0,
  'b' => 1,
        'c' => 1
}

==> 001.rb 37 <==
other = {
  foo:  1,
  'bar' => 2,
}


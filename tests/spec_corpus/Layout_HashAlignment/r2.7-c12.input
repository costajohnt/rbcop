==> .rubocop.yml 215 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/HashAlignment:
  EnforcedHashRocketStyle:
  - table
  - key
  EnforcedColonStyle:
  - table
  - key

==> 000.rb 112 <==
hash = {
  'abcdefg' => 0,
  'abcdef'  => 0,
  'gijk'    => 0,
  'a'       => 0,
  'b' => 1,
        'c' => 1
}

==> 001.rb 37 <==
other = {
  foo:  1,
  'bar' => 2,
}

==> 002.rb 37 <==
x = { **a, b:  1,
      **c, dd: 2 }

==> 003.rb 43 <==
x = { **a, :b  => 1,
      **c, :dd => 2 }

==> 004.rb 52 <==
h = {
  a:      1,
  bbbbbb: 2,
  e:      5, f: 6
}

==> 005.rb 51 <==
h = {
  a:   1,
  bb:  2,
  ccc: 3,
  e: 5, f: 6
}


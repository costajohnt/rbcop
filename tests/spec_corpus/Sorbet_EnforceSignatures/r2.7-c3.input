==> .rubocop.yml 236 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/EnforceSignatures:
  Style: rbs
  ParameterTypePlaceholder: PARAM
  ReturnTypePlaceholder: RET


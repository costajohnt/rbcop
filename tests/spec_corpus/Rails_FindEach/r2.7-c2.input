==> .rubocop.yml 229 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/FindEach:
  AllowedMethods: []
  AllowedPatterns:
  - order
  - lock
  IgnoredMethods: []


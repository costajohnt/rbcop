==> .rubocop.yml 272 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/BlockDelimiters:
  EnforcedStyle: semantic
  ProceduralMethods:
  - tap
  FunctionalMethods:
  - let
  AllowedMethods:
  - lambda
  AllowedPatterns:
  - test


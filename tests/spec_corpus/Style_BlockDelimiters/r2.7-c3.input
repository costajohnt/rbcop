==> .rubocop.yml 223 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/BlockDelimiters:
  EnforcedStyle: braces_for_chaining
  AllowedMethods:
  - proc
  AllowedPatterns:
  - test


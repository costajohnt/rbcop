==> .rubocop.yml 217 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/BlockDelimiters:
  EnforcedStyle: always_braces
  AllowedMethods:
  - proc
  AllowedPatterns:
  - test


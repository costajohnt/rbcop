==> .rubocop.yml 198 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/BlockDelimiters:
  EnforcedStyle: line_count_based
  BracesRequiredMethods:
  - sig

==> 000.rb 71 <==

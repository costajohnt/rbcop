==> .rubocop.yml 261 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/FirstArgumentIndentation:
  EnforcedStyle: special_for_inner_method_call_in_parentheses
  IndentationWidth: 4
Layout/IndentationWidth:
  Width: 2

==> 000.rb 28 <==
run(
    :foo,
    bar: 3
)

==> 001.rb 31 <==
run(
        :foo,
    bar: 3)


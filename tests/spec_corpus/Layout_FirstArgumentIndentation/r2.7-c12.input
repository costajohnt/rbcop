==> .rubocop.yml 246 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/FirstArgumentIndentation:
  EnforcedStyle: consistent_relative_to_receiver
  IndentationWidth: 4
Layout/IndentationWidth:
  Width:


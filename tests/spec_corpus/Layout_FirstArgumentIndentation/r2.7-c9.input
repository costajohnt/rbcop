==> .rubocop.yml 227 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/FirstArgumentIndentation:
  EnforcedStyle: consistent
  IndentationWidth: 4
Layout/IndentationWidth:
  Width: 2

==> 000.rb 28 <==
run(
    :foo,
    bar: 3
)

==> 001.rb 31 <==
run(
        :foo,
    bar: 3)


==> .rubocop.yml 139 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> 000/spec/factories.rb 119 <==
FactoryBot.define do
  factory :post do
    summary { "A summary" }
    sequence :id
    title { "A title" }
  end
end

==> 001/spec/factories.rb 126 <==

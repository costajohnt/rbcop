==> .rubocop.yml 183 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/MessageExpectation:
  EnforcedStyle: expect

==> 000/000_spec.rb 28 <==
allow(foo).to receive(:bar)

==> 001/001_spec.rb 28 <==
expect(foo).to receive(:bar)

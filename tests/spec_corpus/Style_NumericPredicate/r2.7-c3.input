==> .rubocop.yml 180 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/NumericPredicate:
  EnforcedStyle: comparison
  AutoCorrect: true


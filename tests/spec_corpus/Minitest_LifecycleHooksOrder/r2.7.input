==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 263 <==
class FooTest < Minitest::Test
  def after_teardown
    more_cleanup
  end

  def before_setup; end

  def test_something
    assert_equal foo, bar
  end

  def teardown
    cleanup
  end

  def setup
    setup_something
  end

  def test_something_else; end
end


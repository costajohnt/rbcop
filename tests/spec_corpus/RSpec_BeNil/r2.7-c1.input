==> .rubocop.yml 166 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/BeNil:
  EnforcedStyle: be

==> 000/000_spec.rb 23 <==
expect(foo).to be(nil)

==> 001/001_spec.rb 22 <==
expect(foo).to be_nil

==> 002/002_spec.rb 75 <==
expect(foo).to be_truthy
expect(foo).to be_falsey
expect(foo).to be_fooish


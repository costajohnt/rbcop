==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 111 <==
class FooTest < Minitest::Test
  def test_foo
    return baz if something?
    assert_equal foo, bar
  end
end

==> test/001_test.rb 193 <==
class FooTest < Minitest::Test
  def test_foo
    Foo.class_eval do
      it.extend(ClassMethods)
      def foo
        return 100
      end
    end
    assert_equal 100, Foo.new.foo
  end
end


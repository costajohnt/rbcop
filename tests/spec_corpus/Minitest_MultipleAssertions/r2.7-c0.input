==> test/017_test.rb 423 <==
class FooTest < ActiveSupport::TestCase
  test 'something' do
    if condition1
      assert foo
    elsif condition2
      assert foo
    else
      begin
        do_something
      rescue Foo
        assert foo
      rescue Bar
        # noop
      rescue Zoo
        case
        when condition
          assert foo
        else
          assert foo
        end
      else
        assert foo
      end
    end
  end
end


==> .rubocop.yml 200 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/RescueEnsureAlignment:
  Style/AccessModifierDeclarations:
    EnforcedStyle: inline


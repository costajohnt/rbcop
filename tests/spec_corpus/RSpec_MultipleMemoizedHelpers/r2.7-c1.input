==> .rubocop.yml 195 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/MultipleMemoizedHelpers:
  Max: 1
  AllowSubject: false

==> 000/000_spec.rb 66 <==
describe Foo do
  subject { Foo.new }
  let(:foo) { Foo.new }
end

==> 001/001_spec.rb 72 <==
describe Foo do
  subject(:foo) { Foo.new }
  let(:bar) { Foo.new }
end

==> 002/002_spec.rb 73 <==
describe Foo do
  subject!(:foo) { Foo.new }
  let(:bar) { Foo.new }
end

==> 003/003_spec.rb 143 <==
describe Foo do
  subject { Foo.new }
  context do
    subject { Foo.new(1) }
    context do
      subject { Foo.new(1, 2) }
    end
  end
end


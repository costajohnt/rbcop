==> .rubocop.yml 307 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/WordArray:
  MinSize: 0
  WordRegex: !ruby/regexp /\A(?:\p{Word}|\p{Word}-\p{Word}|\n|\t)+\z/
  EnforcedStyle: brackets
Style/PercentLiteralDelimiters:
  PreferredDelimiters:
    default: "()"


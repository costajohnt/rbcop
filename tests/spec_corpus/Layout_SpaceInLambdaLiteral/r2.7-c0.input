==> .rubocop.yml 168 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/SpaceInLambdaLiteral:
  EnforcedStyle: require_space

==> 000.rb 23 <==

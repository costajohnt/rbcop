==> .rubocop.yml 210 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/ClassAndModuleChildren:
  EnforcedStyle: compact
Layout/IndentationStyle:
  EnforcedStyle: tabs


==> .rubocop.yml 108 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> 000.rb 70 <==
unless !a_condition
  some_method
end
some_method unless !a_condition

==> 001.rb 76 <==

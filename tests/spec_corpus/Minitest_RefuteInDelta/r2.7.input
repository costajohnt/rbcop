==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 103 <==
class FooTest < Minitest::Test
  def test_do_something
    refute_equal(0.2, foo, 'message')
  end
end

==> test/001_test.rb 95 <==
class FooTest < Minitest::Test
  def test_do_something
    refute_in_delta(foo, 0.2)
  end
end

==> test/002_test.rb 92 <==

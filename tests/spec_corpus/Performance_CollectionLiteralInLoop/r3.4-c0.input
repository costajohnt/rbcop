==> .rubocop.yml 189 <==
---
plugins:
- rubocop-performance
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.4
Performance/CollectionLiteralInLoop:
  MinSize: 1


  end
end

==> 004/004_spec.rb 198 <==
it 'validates users' do
  [user1, user2, user3].each do
    allow(Something).to receive(:method).and_return(it)
    expect(it).to receive(:method)
    expect(it).to receive(:other_method)
  end
end


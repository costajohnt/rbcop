  end
end

==> 007/007_spec.rb 211 <==
it 'validates users' do
  [user1, user2, user3].each do |user|
    allow(Something).to receive(:method).and_return(user)
    expect(user).to receive(:method)
    expect(user).to receive(:other_method)
  end
end


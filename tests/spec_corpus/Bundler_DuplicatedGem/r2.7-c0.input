==> 006/Gemfile 114 <==
if Dir.exist?(local)
  gem 'rubocop', path: local
  gem 'flog', path: local
else
  gem 'rubocop', '~> 0.90.0'
end

==> 007/Gemfile 258 <==
if Dir.exist?(local)
  gem 'rubocop', path: local
elsif ENV['RUBOCOP_VERSION'] == 'master'
  gem 'rubocop', git: 'https://github.com/rubocop/rubocop.git'
elsif (version = ENV['RUBOCOP_VERSION'])
  gem 'rubocop', version
else
  gem 'rubocop', '~> 0.90.0'
end

==> 008/Gemfile 198 <==

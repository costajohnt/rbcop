==> .rubocop.yml 159 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Bundler/DuplicatedGem:
  Include:
  - "**/Gemfile"


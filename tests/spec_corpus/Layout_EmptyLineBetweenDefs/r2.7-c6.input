==> .rubocop.yml 195 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/EmptyLineBetweenDefs:
  DefLikeMacros:
  - foo
  AllowAdjacentOneLineDefs: true


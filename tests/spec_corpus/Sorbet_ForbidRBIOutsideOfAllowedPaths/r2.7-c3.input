==> .rubocop.yml 236 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/ForbidRBIOutsideOfAllowedPaths:
  AllowedPaths:
  - some/allowed/**
  - hello/other/allowed/**


==> 010/010_spec.rb 279 <==
describe Foo do
  it 'uses expect incorrectly' do
    expect.to eq(bar)
    expect([foo]).to eq(bar)
    expect([[foo]]).to eq(bar)
    expect(foo: 1, bar: foo).to eq(bar)
    expect(1..foo).to eq(bar)
    expect(1...foo).to eq(bar)
    expect(/foo|#{bar}/).to eq(bar)
  end
end


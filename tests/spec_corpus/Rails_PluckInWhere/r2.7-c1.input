==> .rubocop.yml 181 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/PluckInWhere:
  EnforcedStyle: aggressive


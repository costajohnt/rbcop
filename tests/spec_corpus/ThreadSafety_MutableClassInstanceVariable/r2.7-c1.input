==> .rubocop.yml 208 <==
---
plugins:
- rubocop-thread_safety
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
ThreadSafety/MutableClassInstanceVariable:
  EnforcedStyle: strict


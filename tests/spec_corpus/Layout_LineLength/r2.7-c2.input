==> .rubocop.yml 181 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/LineLength:
  Max: 80
  AllowURI: true
  AllowQualifiedName: true


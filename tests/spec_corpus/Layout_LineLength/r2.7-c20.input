==> .rubocop.yml 177 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/LineLength:
  Max: 40
  AllowURI: false
  AllowHeredoc: false

==> 000.rb 70 <==

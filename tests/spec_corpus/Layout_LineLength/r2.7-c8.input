  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/LineLength:
  Max: 18
  AllowedPatterns:
  - "^\\s*test\\s"
  - !ruby/regexp /^\s*def\s+test_/


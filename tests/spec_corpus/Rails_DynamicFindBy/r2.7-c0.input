==> .rubocop.yml 188 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/DynamicFindBy:
  AllowedMethods:
  - find_by_sql


==> .rubocop.yml 179 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.3
Style/MethodCallWithArgsParentheses:
  EnforcedStyle: omit_parentheses


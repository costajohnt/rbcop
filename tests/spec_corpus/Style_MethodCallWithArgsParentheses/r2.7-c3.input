==> .rubocop.yml 192 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/MethodCallWithArgsParentheses:
  AllowedPatterns:
  - "^assert"
  - "^refute"

==> 000.rb 13 <==
assert 2 == 2
==> 001.rb 17 <==
assert_equal 2, 2
==> 002.rb 28 <==
assert_match /^yes/i, result
==> 003.rb 13 <==
refute 2 == 3
==> 004.rb 17 <==
refute_equal 2, 3
==> 005.rb 27 <==
refute_match /^no/i, result

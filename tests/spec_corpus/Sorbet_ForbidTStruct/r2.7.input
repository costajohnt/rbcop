==> test/002_test.rb 325 <==
class Foo < T::Struct
  CONST = 42

  const :foo, Integer

  @foo = 42

  # Some comment
  sig { params(x: Integer).returns(String) }
  def foo(x)
    "foo" * x
  end

  private

  sig do
    void
  end
  def self.bar; end

  class << self
    def bar; end
  end

  # Another comment
  class Bar
    class Baz; end
  end
end


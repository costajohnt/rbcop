==> test/004_test.rb 166 <==
class Foo < T::Struct
  const :a, T.any(Integer, String)
  const :b, T::Array[String]
  const :c, T::Hash[Symbol, Integer]
  const :d, T.all(Comparable, Numeric)
end

==> test/005_test.rb 92 <==
class Foo < T::Struct
  const :a, T.nilable(T.any(Integer, String))
  const :b, Integer
end

==> test/006_test.rb 286 <==
class Outer < T::Struct
  module Namespace
    extend T::Sig
    prop :untouched, String

    class Inner < T::Struct
      const :name, String
    end
  end

  class Other
    const :untouched, String
  end

  class << self
    prop :untouched, String
  end

  const :name, String
end


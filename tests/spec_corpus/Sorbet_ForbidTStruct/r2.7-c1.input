==> .rubocop.yml 180 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/ForbidTStruct:
  AutocorrectStyle: rbs

==> test/000_test.rb 192 <==
class Foo < T::Struct
  const :a, T.untyped
  const :b, T.class_of(Foo)
  const :c, T.proc.params(x: Integer).returns(String)
  const :d, T.noreturn
  const :e, T.something_weird(Integer)
end

==> test/001_test.rb 136 <==
class Foo < T::Struct
  const :foo, Integer
  prop :bar, String, default: "foo"
  const :baz, T.nilable(Symbol), factory: ->{ nil }
end

==> test/002_test.rb 154 <==
class Foo < T::Struct
  const :a, T::Boolean
  const :b, T::Range[Integer]
  const :c, T::Hash[Symbol, T::Boolean]
  const :d, T::Enumerable[Integer]
end

==> test/003_test.rb 64 <==

==> .rubocop.yml 197 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/SpecFilePathFormat:
  CustomTransform:
    FooFoo: foofoo


---
plugins:
- rubocop-rspec
- rubocop-rspec_rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpecRails/InferredSpecType:
  Inferences:
    services: service


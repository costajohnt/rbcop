==> .rubocop.yml 277 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.4
Layout/IndentationWidth:
  Width: 2
  EnforcedStyleAlignWith: start_of_line
  SupportedStylesAlignWith:
  - start_of_line
  - relative_to_receiver
  AllowedPatterns: []


plugins:
- rubocop-thread_safety
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
ThreadSafety/DirChdir:
  Enabled: true
  AllowCallWithBlock: true


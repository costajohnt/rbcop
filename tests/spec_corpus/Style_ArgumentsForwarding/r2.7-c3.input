==> .rubocop.yml 166 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/ArgumentsForwarding:
  AllowOnlyRestArgument: false


==> .rubocop.yml 192 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ExampleWithoutDescription:
  EnforcedStyle: disallow


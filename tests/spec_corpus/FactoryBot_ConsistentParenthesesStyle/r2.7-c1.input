==> .rubocop.yml 235 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
FactoryBot/ConsistentParenthesesStyle:
  EnforcedStyle: :omit_parentheses
  ExplicitOnly: false


==> .rubocop.yml 195 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
FactoryBot/AssociationStyle:
  EnforcedStyle: :explicit

==> 000/spec/factories.rb 44 <==
factory :article do
  association :user
end

==> 001/spec/factories.rb 31 <==
factory :article do
  user
end

==> 002/spec/factories.rb 48 <==
factory :article do

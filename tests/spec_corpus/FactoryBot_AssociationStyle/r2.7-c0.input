==> .rubocop.yml 195 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
FactoryBot/AssociationStyle:
  EnforcedStyle: :implicit

==> 000/spec/factories.rb 50 <==
FactoryBot.define do
  factory :user do
  end
end

==> 001/spec/factories.rb 78 <==
FactoryBot.define do
  factory :user
  factory :admin_user, parent: :user
end

==> 002/spec/factories.rb 62 <==
FactoryBot.define do
  factory :article do
    user
  end
end

==> 003/spec/factories.rb 64 <==

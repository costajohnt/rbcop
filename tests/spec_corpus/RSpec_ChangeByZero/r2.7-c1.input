==> .rubocop.yml 182 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ChangeByZero:
  NegatedMatcher: not_change

==> 000/000_spec.rb 156 <==
it do
  expect { foo }.to change(Foo, :bar).by(0).and change(Foo, :baz).by(0)
  expect { foo }.to change { Foo.bar }.by(0).and change { Foo.baz }.by(0)
end

==> 001/001_spec.rb 330 <==
it do
  expect { foo }
    .to change(Foo, :bar).by(0)
    .and change(Foo, :baz).by(0)
  expect { foo }
    .to change { Foo.bar }.by(0)
    .and change { Foo.baz }.by(0)
  expect { foo }
    .to change(Foo, :bar)
    .and change(Foo, :baz).by(0)
  expect { foo }
    .to change { Foo.bar }
    .and change { Foo.baz }.by(0)
end

==> 002/002_spec.rb 195 <==
it do
  expect { foo }
    .to change(Foo, :bar)
    .by(0)
    .and change(Foo, :baz)
    .by(0)
  expect { foo }
    .to change { Foo.bar }
    .by(0)
    .or change { Foo.baz }
    .by(0)
end

==> 003/003_spec.rb 190 <==
it do
  expect { foo }
    .to change(Foo, :bar)
    .by(0) &
    change(Foo, :baz)
    .by(0)
  expect { foo }
    .to change { Foo.bar }
    .by(0) |
    change { Foo.baz }
    .by(0)
end


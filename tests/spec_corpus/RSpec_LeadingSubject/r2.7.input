==> 005/005_spec.rb 239 <==
RSpec.describe User do
  # This shouldn't really ever happen in a sane codebase but I still
  # want to avoid false positives
  it "doesn't mind me calling a method called subject in the test" do
    let(foo)
    subject { bar }
  end
end


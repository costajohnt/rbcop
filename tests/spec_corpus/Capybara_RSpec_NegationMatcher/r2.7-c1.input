==> .rubocop.yml 192 <==
---
plugins:
- rubocop-capybara
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Capybara/RSpec/NegationMatcher:
  EnforcedStyle: not_to


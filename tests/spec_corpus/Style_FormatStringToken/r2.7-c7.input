==> .rubocop.yml 332 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/FormatStringToken:
  EnforcedStyle: :unannotated
  SupportedStyles:
  - :annotated
  - :template
  - :unannotated
  MaxUnannotatedPlaceholdersAllowed: 0
  AllowedMethods: []
  AllowedPatterns: []
  Mode: :conservative

==> 000.rb 16 <==
'%<greetings>s'

==> 001.rb 21 <==
foo('%<greetings>s')

==> 002.rb 15 <==
'%{greetings}'

==> 003.rb 20 <==

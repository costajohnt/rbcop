==> .rubocop.yml 327 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/FormatStringToken:
  EnforcedStyle: :template
  SupportedStyles:
  - :annotated
  - :template
  - :unannotated
  MaxUnannotatedPlaceholdersAllowed: 0
  AllowedMethods: []
  AllowedPatterns: []
  Mode: :aggressive

==> 000.rb 24 <==
format("%<a>s", a: foo)

==> 001.rb 22 <==
format("%{a}", a: foo)
==> 002.rb 10 <==
"%<foo>s"


==> .rubocop.yml 328 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/FormatStringToken:
  EnforcedStyle: :annotated
  SupportedStyles:
  - :annotated
  - :template
  - :unannotated
  MaxUnannotatedPlaceholdersAllowed: 0
  AllowedMethods: []
  AllowedPatterns: []
  Mode: :aggressive


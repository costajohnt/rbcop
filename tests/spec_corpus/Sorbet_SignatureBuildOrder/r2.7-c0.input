==> .rubocop.yml 196 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/SignatureBuildOrder:
  Order:
  - returns
  - override


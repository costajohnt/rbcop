==> .rubocop.yml 180 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/InstanceVariable:
  AssignmentOnly: true

==> 000/000_spec.rb 81 <==
describe MyClass do
  before { @foo = [] }
  it { expect(@foo).to be_empty }
end

==> 001/001_spec.rb 58 <==
describe MyClass do
  it { expect(@foo).to be_empty }
end

==> 002/002_spec.rb 109 <==
describe MyClass do
  context 'foo' do
    before { @foo = [] }
  end

  it { expect(@foo).to be_empty }
end


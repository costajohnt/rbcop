==> .rubocop.yml 188 <==
---
plugins:
- rubocop-capybara
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Capybara/RSpec/HaveSelector:
  DefaultSelector: css


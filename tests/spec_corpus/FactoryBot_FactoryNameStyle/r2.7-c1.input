==> .rubocop.yml 215 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
FactoryBot/FactoryNameStyle:
  EnforcedStyle: :string
  ExplicitOnly: false


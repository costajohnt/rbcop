==> .rubocop.yml 188 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ItBehavesLike:
  EnforcedStyle: :it_behaves_like

==> 000/000_spec.rb 30 <==
it_should_behave_like 'a foo'

==> 001/001_spec.rb 23 <==
it_behaves_like 'a foo'

==> .rubocop.yml 194 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ItBehavesLike:
  EnforcedStyle: :it_should_behave_like

==> 000/000_spec.rb 24 <==
it_behaves_like 'a foo'

==> 001/001_spec.rb 29 <==
it_should_behave_like 'a foo'

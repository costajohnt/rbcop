==> .rubocop.yml 171 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Lint/UnusedBlockArgument:
  AllowUnusedKeywordArguments: false


==> .rubocop.yml 180 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/FirstMethodArgumentLineBreak:
  AllowMultilineFinalElement: true

==> 000.rb 21 <==
foo(bar, {
  a: b
})

==> 001.rb 16 <==
foo({
  a: b
})

==> 002.rb 26 <==
foo(bar, {
  a: b
}, baz)

==> 003.rb 14 <==
foo(bar,
baz)


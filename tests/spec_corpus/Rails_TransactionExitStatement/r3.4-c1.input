==> .rubocop.yml 212 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.4
Rails/TransactionExitStatement:
  TransactionMethods:
  - writable_transaction


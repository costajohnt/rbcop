==> .rubocop.yml 212 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/TransactionExitStatement:
  TransactionMethods:
  - writable_transaction


==> .rubocop.yml 177 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Gemspec/OrderedDependencies:
  TreatCommentsAsGroupSeparators: false


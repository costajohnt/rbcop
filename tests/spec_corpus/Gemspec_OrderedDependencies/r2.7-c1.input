==> .rubocop.yml 176 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Gemspec/OrderedDependencies:
  TreatCommentsAsGroupSeparators: true


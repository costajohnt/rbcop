==> .rubocop.yml 147 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Metrics/CyclomaticComplexity:
  Max: 2

==> 000.rb 200 <==
def method_name
  if first_condition then
    call_foo
  else
    if second_condition then
      call_bar
    else
      call_bam if third_condition
    end
    call_baz if fourth_condition
  end
end


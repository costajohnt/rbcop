  let!(:foo) { bar }

  it 'uses foo' do
    foo
    expect(baz).to eq(qux)
  end
end

==> 003/003_spec.rb 213 <==
describe Foo do
  context 'when something special happens' do
    let!(:foo) { bar }

    it 'does not use foo' do
      expect(baz).to eq(qux)
    end
  end

  it 'references some other foo' do
    foo
  end
end


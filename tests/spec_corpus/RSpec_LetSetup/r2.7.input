==> 015/015_spec.rb 160 <==
describe User do
  [1, 2, 3].each do |i|
    let!(:user) { create(:user, id: i) }

    it 'creates user' do
      expect(User.count).to eq(3)
    end
  end
end

==> 016/016_spec.rb 314 <==
describe User do
  let!(:user) { create(:user) }

  it 'uses user' do
    expect(user).to be_valid
  end

  [true, false].each do |flag|
    context "when flag is #{flag}" do
      let!(:user) { create(:user, flag: flag) }

      it 'setup only' do
        expect(User.count).to be > 0
      end
    end
  end
end


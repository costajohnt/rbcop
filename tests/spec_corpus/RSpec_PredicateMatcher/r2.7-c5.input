==> .rubocop.yml 247 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/PredicateMatcher:
  EnforcedStyle: explicit
  Strict: false
  AllowedExplicitMatchers:
  - have_http_status


==> .rubocop.yml 223 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: case
  IndentOneStep: true
Layout/IndentationStyle:
  EnforcedStyle: tabs


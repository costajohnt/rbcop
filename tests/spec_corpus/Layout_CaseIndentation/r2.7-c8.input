==> .rubocop.yml 222 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: end
  IndentOneStep: true
Layout/IndentationStyle:
  EnforcedStyle: tabs

==> 000.rb 33 <==
	x = case a
    when b
			c
	end

==> 001.rb 31 <==
	x = case a
		when b
			c
	end


==> .rubocop.yml 176 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: end
  IndentOneStep: false

==> 000.rb 39 <==
case foo; when :bar then 1; else 0; end
==> 001.rb 60 <==
case variable
when 'value1'
when 'value2'
else 'value3' end

==> 002.rb 72 <==

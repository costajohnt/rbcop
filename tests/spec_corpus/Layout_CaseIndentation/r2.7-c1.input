==> .rubocop.yml 176 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: case
  IndentOneStep: true

==> 000.rb 39 <==

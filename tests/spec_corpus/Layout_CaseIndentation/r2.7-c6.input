---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: case
  IndentOneStep: false
Layout/IndentationStyle:
  EnforcedStyle: tabs


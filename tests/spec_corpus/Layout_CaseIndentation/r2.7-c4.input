==> .rubocop.yml 175 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/CaseIndentation:
  EnforcedStyle: end
  IndentOneStep: true

==> 000.rb 39 <==
case foo; when :bar then 1; else 0; end
==> 001.rb 78 <==
output = case variable
  when 'value1'
    'output1'
  else
    'output2'
end

==> 002.rb 115 <==

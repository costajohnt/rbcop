==> .rubocop.yml 200 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.0
Style/EndlessMethod:
  EnforcedStyle: disallow
Layout/LineLength:
  Enabled: true
  Max: 80


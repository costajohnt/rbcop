==> .rubocop.yml 211 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.0
Style/EndlessMethod:
  EnforcedStyle: require_single_line
Layout/LineLength:
  Enabled: true
  Max: 80


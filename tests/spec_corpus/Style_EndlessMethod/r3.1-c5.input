==> .rubocop.yml 206 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.1
Style/EndlessMethod:
  EnforcedStyle: require_always
Layout/LineLength:
  Enabled: true
  Max: 80

==> 000.rb 34 <==

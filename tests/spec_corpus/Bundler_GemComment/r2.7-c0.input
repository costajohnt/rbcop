==> .rubocop.yml 194 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Bundler/GemComment:
  Include:
  - "**/Gemfile"
  AllowedGems:
  - rake
  OnlyFor: []


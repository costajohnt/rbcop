==> .rubocop.yml 232 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/ExtraSpacing:
  AllowForAlignment: true
  ForceEqualSignAlignment: true
Layout/LineLength:
  Enabled: true
  Max: 20


==> .rubocop.yml 201 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Naming/PredicatePrefix:
  NamePrefix:
  - has_
  - is_
  ForbiddenPrefixes:
  - has_
  - is_


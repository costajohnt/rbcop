==> .rubocop.yml 193 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/MultilineAssignmentLayout:
  EnforcedStyle: new_line
  SupportedTypes:
  - if

==> 000.rb 20 <==

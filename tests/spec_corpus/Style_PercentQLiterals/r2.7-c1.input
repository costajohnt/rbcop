==> .rubocop.yml 162 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/PercentQLiterals:
  EnforcedStyle: upper_case_q


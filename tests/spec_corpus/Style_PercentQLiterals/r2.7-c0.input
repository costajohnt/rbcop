==> .rubocop.yml 162 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/PercentQLiterals:
  EnforcedStyle: lower_case_q


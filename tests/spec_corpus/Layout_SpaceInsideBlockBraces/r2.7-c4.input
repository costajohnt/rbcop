==> .rubocop.yml 242 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/SpaceInsideBlockBraces:
  EnforcedStyle: no_space
  SupportedStyles:
  - space
  - no_space
  SpaceBeforeBlockParameters: true


==> .rubocop.yml 195 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/PercentLiteralDelimiters:
  PreferredDelimiters:
    default: "[]"
    "%": "()"

==> 000.rb 23 <==
%w[string] + %i[string]
==> 001.rb 24 <==
%w[string] + [%(string)]

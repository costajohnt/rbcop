==> .rubocop.yml 133 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> app/controllers/000/000.rb 70 <==
skip_before_action :login_required, only: :show, if: :trusted_origin?

==> app/controllers/001/001.rb 87 <==
skip_before_action :login_required, :another_action, only: :show, if: :trusted_origin?

==> app/controllers/002/002.rb 73 <==
skip_before_action :login_required, except: :admin, if: :trusted_origin?

==> app/controllers/003/003.rb 88 <==
skip_before_action :login_required, if: -> { trusted_origin? && action_name == "show" }


==> .rubocop.yml 179 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ClassCheck:
  EnforcedStyle: be_kind_of

==> 000/000_spec.rb 27 <==

==> .rubocop.yml 465 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/SkipsModelValidations:
  ForbiddenMethods:
  - decrement!
  - decrement_counter
  - increment!
  - increment_counter
  - insert
  - insert!
  - insert_all
  - insert_all!
  - toggle!
  - touch
  - touch_all
  - update_all
  - update_attribute
  - update_column
  - update_columns
  - update_counters
  - upsert
  - upsert_all


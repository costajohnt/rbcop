==> 006/006_spec.rb 225 <==
RSpec.describe User do
  before(:each) { setup }
  after(:each) { cleanup }

  it { is_expected.to be_after_hooks }

  context 'a context' do
    it { is_expected.to work }
  end

  include_examples('everything is fine')
end

==> 007/007_spec.rb 188 <==
RSpec.describe User do
  before { setup }

  context 'something else' do
    before { additional_setup }
    it { is_expected.to work }
  end

  include_examples('everything is fine')
end


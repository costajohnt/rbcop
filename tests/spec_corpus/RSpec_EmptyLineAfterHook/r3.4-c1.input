==> .rubocop.yml 194 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.4
RSpec/EmptyLineAfterHook:
  AllowConsecutiveOneLiners: false


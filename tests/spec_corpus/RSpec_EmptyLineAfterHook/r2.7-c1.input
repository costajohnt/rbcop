==> .rubocop.yml 194 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/EmptyLineAfterHook:
  AllowConsecutiveOneLiners: false


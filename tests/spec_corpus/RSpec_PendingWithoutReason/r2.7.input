==> 007/007_spec.rb 290 <==
RSpec.describe Foo do
  it 'does something' do
    expect('foo').to eq(pending)
    expect('foo').to eq(skip)
    foo(bar, pending, skip)
    foo(bar, pending: pending, skip: skip)
    is_expected.to match_array([foo, pending, skip, bar])
    list = [skip, pending]
    foo(list)
  end
end


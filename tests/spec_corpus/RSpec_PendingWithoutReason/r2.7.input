==> .rubocop.yml 133 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> 000/000_spec.rb 196 <==
RSpec.describe Foo do
  it 'does something' do
    pending 'reason'
    pending "#{reason}"
    pending `echo #{reason}`
    skip 'reason'
    skip "#{reason}"
    skip `echo #{reason}`
  end
end


==> .rubocop.yml 181 <==
---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/ForbidTAbsurd:
  AutocorrectToRBS: true


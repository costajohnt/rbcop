==> .rubocop.yml 179 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/NestedGroups:
  AllowedGroups:
  - path


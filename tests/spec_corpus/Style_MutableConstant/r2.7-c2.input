==> .rubocop.yml 175 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/MutableConstant:
  EnforcedStyle: literals
  Recursive: true


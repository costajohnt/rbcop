==> .rubocop.yml 183 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/NamedSubject:
  IgnoreSharedExamples: false


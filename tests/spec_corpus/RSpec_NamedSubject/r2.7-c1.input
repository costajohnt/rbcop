==> 004/004_spec.rb 260 <==
RSpec.describe User do
  subject(:new_user) { described_class.new }

  shared_examples_for 'a valid new user' do
    it "is a User" do
      expect(subject).to be_a(User)
    end

    it "is valid" do
      expect(subject.valid?).to be(true)
    end
  end
end


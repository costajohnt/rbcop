==> .rubocop.yml 182 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/NamedSubject:
  EnforcedStyle: :named_only

==> 000/000_spec.rb 187 <==
RSpec.describe User do
  subject { described_class.new }

  it "is a User" do
    expect(subject).to be_a(User)
  end

  it "is valid" do
    expect(subject.valid?).to be(true)
  end
end


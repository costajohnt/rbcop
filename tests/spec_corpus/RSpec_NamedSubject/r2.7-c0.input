==> 004/004_spec.rb 353 <==
RSpec.describe User do
  subject(:user) { described_class.new }

  describe 'valid' do
    subject(:valid) { described_class.new.valid? }

    it 'is valid' do
      expect(valid).to be(true)
    end
  end

  describe 'age' do
    subject { user.age }
    it 'allows driving a car' do
      expect(subject.can_drive_a_car).to be(true)
    end
  end
end


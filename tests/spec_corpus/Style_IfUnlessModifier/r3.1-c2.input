==> .rubocop.yml 230 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.1
Layout/LineLength:
  Enabled: true
  Max: 80
  AllowURI: true
  AllowCopDirectives: true
  URISchemes:
  - http
  - https


==> .rubocop.yml 308 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Naming/FileName:
  IgnoreExecutableScripts: true
  ExpectMatchingDefinition: false
  Regex:
  CheckDefinitionPathHierarchy: true
  CheckDefinitionPathHierarchyRoots:
  - lib
  - spec
  - test
  - src


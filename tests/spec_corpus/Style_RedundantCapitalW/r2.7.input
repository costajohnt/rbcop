def dangerous_characters
  %W(\000) +
  %W(\001) +
  %W(\027) +
  %W(\002) +
  %W(\003) +
  %W(\004) +
  %W(\005) +
  %W(\006) +
  %W(\007) +
  %W(\00) +
  %W(\a)
  %W(\s)
  %W(\n)
  %W(\!)
end


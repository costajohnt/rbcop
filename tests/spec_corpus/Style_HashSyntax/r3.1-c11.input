==> .rubocop.yml 231 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.1
Style/HashSyntax:
  EnforcedStyle: ruby19
  SupportedStyles:
  - ruby19
  - hash_rockets
  EnforcedShorthandSyntax: either

==> 000.rb 13 <==
{foo:, bar:}

==> 001.rb 27 <==
{foo:, bar: bar, baz: qux}

==> 002.rb 21 <==
{foo: bar, bar: foo}

==> 003.rb 21 <==
{foo: foo, bar: bar}


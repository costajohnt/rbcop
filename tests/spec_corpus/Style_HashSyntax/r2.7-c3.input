==> .rubocop.yml 243 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/HashSyntax:
  EnforcedStyle: hash_rockets
  SupportedStyles:
  - ruby19
  - hash_rockets
  UseHashRocketsWithSymbolValues: false


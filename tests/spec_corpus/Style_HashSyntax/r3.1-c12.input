  baz
end

==> 007.rb 30 <==
unless foo bar: bar
  baz
end

==> 008.rb 29 <==
while foo bar: bar
  baz
end

==> 009.rb 29 <==
until foo bar: bar
  baz
end

==> 010.rb 20 <==

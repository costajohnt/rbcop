==> .rubocop.yml 230 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.1
Style/HashSyntax:
  EnforcedStyle: ruby19
  SupportedStyles:
  - ruby19
  - hash_rockets
  EnforcedShorthandSyntax: never

==> 000.rb 13 <==
{foo:, bar:}

==> 001.rb 27 <==
{foo:, bar: bar, baz: qux}

==> 002.rb 60 <==
def do_something(if:, next:, bar:)
  {if:, next:, bar:}
end

==> 003.rb 21 <==
{foo: bar, bar: foo}

==> 004.rb 21 <==
{foo: foo, bar: bar}


==> 001.rb 246 <==
def m
  [0, 1].reduce { |a, e| a + e }
  [0, 1].reduce{ |a, e| a + e }
  [0, 1].reduce(5) { |a, e| a + e }
  [0, 1].reduce(5){ |a, e| a + e }
  [0, 1].reduce (5) { |a, e| a + e }
  [0, 1].reduce(5) { |a, e| a + e }
  ala.test { |x, y| bala }
end


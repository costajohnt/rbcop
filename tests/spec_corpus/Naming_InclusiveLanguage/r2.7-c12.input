==> .rubocop.yml 246 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Naming/InclusiveLanguage:
  CheckStrings: true
  FlaggedTerms:
    master:
      Suggestions:
      - main
      - primary
      - leader


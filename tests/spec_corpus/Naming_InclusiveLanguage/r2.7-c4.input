==> .rubocop.yml 306 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Naming/InclusiveLanguage:
  FlaggedTerms:
    master:
      Suggestions:
      - main
      - primary
      - leader
    slave:
      Suggestions:
      - replica
      - secondary
      - follower

==> 000.rb 22 <==
master, slave = nodes


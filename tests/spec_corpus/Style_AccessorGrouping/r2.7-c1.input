==> .rubocop.yml 159 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/AccessorGrouping:
  EnforcedStyle: separated

==> 000.rb 86 <==
class Foo
  attr_reader :bar, :baz
  attr_accessor :quux
  other_macro :zoo, :woo
end

==> 001.rb 203 <==
class Foo
  attr_reader :bar1, :bar2

  protected
  attr_accessor :quux

  private
  attr_reader :baz1, :baz2
  attr_writer :baz3
  attr_reader :baz4

  public
  attr_reader :bar3
  other_macro :zoo
end

==> 002.rb 152 <==
class Foo
  attr_reader :bar

  class << self
    attr_reader :baz1, :baz2
    attr_reader :baz3

    private

    attr_reader :quux1, :quux2
  end
end


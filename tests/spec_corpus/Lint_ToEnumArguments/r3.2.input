==> .rubocop.yml 108 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 3.2

==> 000.rb 100 <==
def do_something(*)
  return to_enum(:do_something, *) unless block_given?

  do_something_else
end

==> 001.rb 102 <==
def do_something(**)
  return to_enum(:do_something, **) unless block_given?

  do_something_else
end


==> .rubocop.yml 207 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/IndexedLet:
  Max: 1
  AllowedIdentifiers: []
  AllowedPatterns: []

==> 000/000_spec.rb 94 <==

==> .rubocop.yml 213 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/IndexedLet:
  Max: 1
  AllowedIdentifiers: []
  AllowedPatterns:
  - item


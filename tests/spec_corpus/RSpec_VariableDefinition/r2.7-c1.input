==> .rubocop.yml 184 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/VariableDefinition:
  EnforcedStyle: strings


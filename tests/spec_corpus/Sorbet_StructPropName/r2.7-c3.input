---
plugins:
- rubocop-sorbet
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Sorbet/StructPropName:
  AllowedPatterns:
  - "\\Alegacy_name\\z"
  ForbiddenIdentifiers:
  - legacy_name


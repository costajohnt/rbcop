==> 109.rb 249 <==
def some_method(items)
  step = :load
  begin
    unless items.empty?
      step = :prepare
      prepare(items)
      step = :process
      process(items)
    end
  rescue StandardError => e
    puts "failed during #{step}: #{e.message}"
  end
end

==> 110.rb 249 <==
def some_method(items, flag)
  step = :load
  begin
    unless items.empty?
      if flag
        step = :prepare
        prepare(items)
        step = :process
        process(items)
      end
    end
  rescue StandardError
    puts step
  end
end


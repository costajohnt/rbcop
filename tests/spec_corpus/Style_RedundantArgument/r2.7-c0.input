==> .rubocop.yml 261 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/RedundantArgument:
  Methods:
    join: ''
    sum: 0
    exit: true
    exit!: false
    to_i: 10
    split: " "
    chomp: "\n"
    chomp!: "\n"

==> 000.rb 109 <==

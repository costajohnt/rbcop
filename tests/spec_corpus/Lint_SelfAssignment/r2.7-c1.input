==> .rubocop.yml 163 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Lint/SelfAssignment:
  AllowRBSInlineAnnotation: false

==> 000.rb 324 <==
foo = foo #: Integer
@foo = @foo #: Integer
@@foo = @@foo #: Integer
$foo = $foo #: Integer
Foo = Foo #: Integer
foo, bar = foo, bar #: Integer
foo ||= foo #: Integer
foo &&= foo #: Integer
foo.bar = foo.bar #: Integer
foo&.bar = foo&.bar #: Integer
foo["bar"] = foo["bar"] #: Integer
foo&.[]=("bar", foo["bar"]) #: Integer


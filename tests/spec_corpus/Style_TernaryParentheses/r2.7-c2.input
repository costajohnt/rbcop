==> .rubocop.yml 203 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/TernaryParentheses:
  EnforcedStyle: require_no_parentheses
  AllowSafeAssignment: false


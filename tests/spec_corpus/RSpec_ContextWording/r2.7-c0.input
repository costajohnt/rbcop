==> .rubocop.yml 219 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ContextWording:
  Prefixes:
  - when
  - with
  - without
  AllowedPatterns: []


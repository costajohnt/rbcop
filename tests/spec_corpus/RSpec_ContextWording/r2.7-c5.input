==> .rubocop.yml 208 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ContextWording:
  Prefixes:
  - when
  AllowedPatterns:
  - patterns


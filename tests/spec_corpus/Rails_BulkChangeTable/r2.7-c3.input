==> .rubocop.yml 224 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
  TargetRailsVersion: 5.1
Rails/BulkChangeTable:
  Database: postgresql
  Include:
  - "*"


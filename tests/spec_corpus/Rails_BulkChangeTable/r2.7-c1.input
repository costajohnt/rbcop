==> 014/014.rb 230 <==
def change
  change_table :users do |t|
    if Rails.env.test?
      t.string :name, null: true
      t.string :address, null: true
    else
      t.string :name, null: false
      t.string :address, null: false
    end
  end
end

==> 015/015.rb 261 <==
def change
  reversible do |dir|
    change_table :users do |t|
      dir.up do
        t.string :name, null: false
        t.string :address, null: false
      end

      dir.down do
        t.remove :name
        t.remove :address
      end
    end
  end
end


==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 115 <==
class FooTest < Minitest::Test
  def test_do_something
    assert(obj.expected.equal?(other_obj.actual))
  end
end

==> test/001_test.rb 120 <==
class FooTest < Minitest::Test
  def test_do_something
    assert_equal(expected.object_id, actual.object_id)
  end
end

==> test/002_test.rb 99 <==
class FooTest < Minitest::Test
  def test_do_something
    assert_same(expected, actual)
  end
end

==> test/003_test.rb 130 <==
class FooTest < Minitest::Test
  def test_do_something
    assert(expected.eql?(actual))
    assert(foo.combines?(bar))
  end
end

==> test/004_test.rb 112 <==

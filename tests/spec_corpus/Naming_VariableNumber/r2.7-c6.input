==> .rubocop.yml 274 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Naming/VariableNumber:
  AllowedIdentifiers: []
  AllowedPatterns:
  - _v\d+\z
  - allow_me
  CheckSymbols: true
  CheckMethodNames: true
  EnforcedStyle: snake_case

==> 000.rb 14 <==

==> .rubocop.yml 210 <==
---
plugins:
- rubocop-factory_bot
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
FactoryBot/CreateList:
  EnforcedStyle: :n_times
  ExplicitOnly: false


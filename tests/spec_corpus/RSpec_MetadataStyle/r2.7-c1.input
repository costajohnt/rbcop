==> .rubocop.yml 176 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/MetadataStyle:
  EnforcedStyle: hash


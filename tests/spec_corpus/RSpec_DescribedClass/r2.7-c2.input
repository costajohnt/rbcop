==> .rubocop.yml 189 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/DescribedClass:
  EnforcedStyle: :described_class


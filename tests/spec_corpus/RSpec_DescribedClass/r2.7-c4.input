==> .rubocop.yml 218 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/DescribedClass:
  EnforcedStyle: :described_class
  OnlyStaticConstants: false


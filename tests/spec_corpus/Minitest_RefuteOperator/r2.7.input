==> .rubocop.yml 136 <==
---
plugins:
- rubocop-minitest
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> test/000_test.rb 94 <==
class FooTest < Minitest::Test
  def test_do_something
    refute expected < actual
  end
end

==> test/001_test.rb 80 <==
class FooTest < Minitest::Test
  def test_do_something
    refute(-x)
  end
end

==> test/002_test.rb 107 <==
class FooTest < Minitest::Test
  def test_do_something
    refute_operator(expected, :<, actual)
  end
end

==> test/003_test.rb 99 <==
class FooTest < Minitest::Test
  def test_do_something
    refute(array_of_booleans[42])
  end
end

==> test/004_test.rb 95 <==
class FooTest < Minitest::Test
  def test_do_something
    refute(expected < actual)
  end
end

==> test/005_test.rb 105 <==
class FooTest < Minitest::Test
  def test_do_something
    var = do_something

    refute(var)
  end
end

==> test/006_test.rb 106 <==
class FooTest < Minitest::Test
  def test_do_something
    refute(expected < actual, 'message')
  end
end


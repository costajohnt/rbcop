==> .rubocop.yml 220 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Layout/SpaceAroundBlockParameters:
  EnforcedStyleInsidePipes: space
Layout/SpaceInsideParens:
  Enabled: false


==> .rubocop.yml 190 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ImplicitSubject:
  EnforcedStyle: require_implicit


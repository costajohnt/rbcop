==> .rubocop.yml 195 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ImplicitSubject:
  EnforcedStyle: single_statement_only


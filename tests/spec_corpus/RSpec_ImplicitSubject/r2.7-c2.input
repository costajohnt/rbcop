==> .rubocop.yml 182 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/ImplicitSubject:
  EnforcedStyle: disallow

==> 000/000_spec.rb 63 <==

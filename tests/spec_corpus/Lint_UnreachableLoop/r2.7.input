==> 017.rb 263 <==
until x > 0

  items.each do |item|
    next if item.odd?
    break
  end

  if x > 0
    break some_value
  else
    raise MyError
  end

  loop do

    case y
    when 1
      return something
    when 2
      break
    else
      throw :exit
    end
  end
end


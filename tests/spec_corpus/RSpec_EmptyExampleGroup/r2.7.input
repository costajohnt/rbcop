==> 023/023_spec.rb 357 <==
RSpec.describe Foo do
  def self.with_yaml_loaded(&block)
    context 'with YAML loaded' do
      module_exec(&block)
    end
  end

  class << self
    def without_yaml_loaded(&block)
      context 'without YAML loaded' do
        module_exec(&block)
      end
    end
  end

  with_yaml_loaded do
    it_behaves_like 'normal YAML serialization'
  end
end


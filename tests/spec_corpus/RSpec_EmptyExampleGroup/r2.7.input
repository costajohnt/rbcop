==> 002/002_spec.rb 341 <==
context 'hook with implicit scope' do
  before do
    it { is_expected.to never_run }
  end
end

context 'hook with explicit scope' do
  around(:example) do
    it { is_expected.to never_run }
  end
end

context 'hook with explicit scope and metadata' do
  after(:each, :corrupt, type: :cop) do
    it { is_expected.to never_run }
  end
end


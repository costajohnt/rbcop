==> .rubocop.yml 206 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Lint/MissingCopEnableDirective:
  MaxRangeSize: .inf
Layout/SpaceAroundOperators:
  Enabled: true


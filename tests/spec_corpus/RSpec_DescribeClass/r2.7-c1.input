==> .rubocop.yml 212 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpec/DescribeClass:
  IgnoredMetadata:
    foo:
    - bar
    type:
    - wow

==> 000/000_spec.rb 37 <==
describe 'foo bar', foo: :bar do
end

==> 001/001_spec.rb 49 <==
describe 'my new system test', type: :wow do
end


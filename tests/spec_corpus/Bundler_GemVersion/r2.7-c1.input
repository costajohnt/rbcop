==> .rubocop.yml 180 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Bundler/GemVersion:
  EnforcedStyle: forbidden
  AllowedGems:
  - rspec


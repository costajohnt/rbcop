==> .rubocop.yml 133 <==
---
plugins:
- rubocop-rspec
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7

==> 000/000_spec.rb 84 <==
RSpec.describe User do
  it { is_expected.to be_after_let }
  let(:foo) { bar }
end

==> 001/001_spec.rb 118 <==
RSpec.describe User do
  context 'a context' do
    it { is_expected.to be_after_let }
  end

  let(:foo) { bar }
end

==> 002/002_spec.rb 124 <==
RSpec.describe User do
  include_examples('should be BEFORE let as it defines `let(:foo)`, too')

  let(:foo) { 'bar' }
end

==> 003/003_spec.rb 89 <==
RSpec.describe User do
  it_behaves_like('should be after let')

  let(:foo) { bar }
end

==> 004/004_spec.rb 102 <==
RSpec.describe User do
  it_behaves_like('should be after let')

  let(:user, &args[:build_user])
end

==> 005/005_spec.rb 128 <==
RSpec.describe User do
  it_behaves_like('should be after let')

  let(:foo) { (<<-SOURCE) }
  some long text here
  SOURCE
end

==> 006/006_spec.rb 189 <==
RSpec.describe User do
  let(:foo) { bar }

  it { is_expected.to be_after_let }

  context 'a context' do
    it { is_expected.to work }
  end

  it_behaves_like('everything is fine')
end

==> 007/007_spec.rb 178 <==
RSpec.describe User do
  let(:foo) { bar }

  context 'something else' do
    let(:foo) { baz }
    it { is_expected.to work }
  end

  it_behaves_like('everything is fine')
end

==> 008/008_spec.rb 81 <==
RSpec.describe User do
  include_context 'special user'

  let(:foo) { bar }
end

==> 009/009_spec.rb 91 <==
RSpec.describe User do
  it_behaves_like 'special user' do
    let(:foo) { bar }
  end
end


==> .rubocop.yml 177 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/I18nLazyLookup:
  EnforcedStyle: lazy


==> .rubocop.yml 205 <==
---
plugins:
- rubocop-rspec
- rubocop-rspec_rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpecRails/HttpStatus:
  EnforcedStyle: be_status


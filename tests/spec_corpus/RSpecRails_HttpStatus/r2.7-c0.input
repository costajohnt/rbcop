==> .rubocop.yml 204 <==
---
plugins:
- rubocop-rspec
- rubocop-rspec_rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
RSpecRails/HttpStatus:
  EnforcedStyle: symbolic


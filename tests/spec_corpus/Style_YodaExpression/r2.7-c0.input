==> .rubocop.yml 168 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Style/YodaExpression:
  SupportedOperators:
  - "*"
  - "+"


==> .rubocop.yml 213 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/Present:
  NotNilAndNotEmpty: false
  NotBlank: false
  UnlessBlank: true


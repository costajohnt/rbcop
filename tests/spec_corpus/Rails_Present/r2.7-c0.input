==> .rubocop.yml 213 <==
---
plugins:
- rubocop-rails
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Rails/Present:
  NotNilAndNotEmpty: true
  NotBlank: false
  UnlessBlank: false

==> 000/000.rb 8 <==
foo.nil?
==> 001/001.rb 10 <==
foo.empty?
==> 002/002.rb 22 <==
foo.nil? || bar.empty?
==> 003/003.rb 18 <==
foo && !bar.empty?
==> 004/004.rb 19 <==
foo && !foo.empty?

==> 005/005.rb 25 <==
!foo.nil? && !foo.empty?

==> 006/006.rb 17 <==
!nil? && !empty?

==> 007/007.rb 26 <==
foo != nil && !foo.empty?

==> 008/008.rb 21 <==

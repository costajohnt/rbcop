==> .rubocop.yml 180 <==
---
AllCops:
  EnabledByDefault: true
  NewCops: enable
  SuggestExtensions: false
  TargetRubyVersion: 2.7
Lint/RedundantSplatExpansion:
  AllowPercentLiteralArrayArgument: false

==> 000.rb 31 <==
